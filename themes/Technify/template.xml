<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Template isFullResponsive="true">
    <Name>Technify</Name>
    <Author>Themeart GmbH</Author>
    <URL>https://www.themeart.de</URL>
    <Parent>Remake</Parent>
    <MinShopVersion>5.2.2</MinShopVersion>
    <Version>1.0.0</Version>
    <Preview>preview.png</Preview>
    <Description>JTL-Shop Responsive-Template für eigene Anpassungen. <![CDATA[<br><a href="https://www.themeart.de" target="_blank" rel="nofollow">Erstellt mit <i class="fa fa-heart"></i> von Themeart</a>]]></Description>
    <Framework>Bootstrap4</Framework>
    <Settings>
        <Section Name="Theme" Key="theme">
            <Setting Description="Theme" Key="theme_default" Type="select" Value="technify" Editable="true" override="true">
                <Option Value="technify">Technify</Option>
            </Setting>
        </Section>
    </Settings>
    <Minify>
        <CSS Name="technify.css">
            <File Path="themes/technify/technify.css"/>
            <File Path="themes/technify/custom.css"/>
        </CSS>
    </Minify>
    <Boxes>
        <Container Position="left" Available="1"></Container>
        <Container Position="right" Available="0"></Container>
        <Container Position="top" Available="0"></Container>
        <Container Position="bottom" Available="1"></Container>
    </Boxes>
</Template>

<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Template isFullResponsive="true">
    <Name>Parfe</Name>
    <Author>Themeart GmbH</Author>
    <URL>https://www.themeart.de</URL>
    <Parent>Remake</Parent>
    <MinShopVersion>5.2.2</MinShopVersion>
    <Version>1.0.0</Version>
    <Preview>preview.png</Preview>
    <Description>Willkommen in unserer Duftoase, präsentiert in einem zauberhaften Parfüm-Theme, das von der Anmut und Leichtigkeit der Rose inspiriert ist.</Description>
    <Framework>Bootstrap4</Framework>
    <Settings>
        <Section Name="Theme" Key="theme">
            <Setting Description="Theme" Key="theme_default" Type="select" Value="parfe" Editable="true" override="true">
                <Option Value="parfe">Parfe</Option>
            </Setting>
        </Section>
    </Settings>
    <Minify>
        <CSS Name="parfe.css">
            <File Path="themes/parfe/parfe.css"/>
            <File Path="themes/parfe/custom.css"/>
        </CSS>
    </Minify>
    <Boxes>
        <Container Position="left" Available="1"></Container>
        <Container Position="right" Available="0"></Container>
        <Container Position="top" Available="0"></Container>
        <Container Position="bottom" Available="1"></Container>
    </Boxes>
</Template>
